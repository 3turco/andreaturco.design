# Header di sicurezza — Cloudflare Pages applica questo file a ogni risposta.
# Fonte: report scanner del 2026-10-22 (HSTS, CSP, clickjacking, Permissions-Policy).
/*
  # HTTPS obbligato per 6 mesi. Passare a 31536000 dopo un periodo senza problemi.
  # includeSubDomains e preload: aggiungere solo dopo aver verificato tutti i sottodomini.
  Strict-Transport-Security: max-age=15552000

  # Anti-clickjacking: nessun sito può incorporare la pagina in un iframe.
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

  # CSP completa in sola segnalazione: non blocca nulla, le violazioni compaiono
  # nella console del browser. Passare a Content-Security-Policy quando è pulita.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
