---
interface Props {
  title: string;
  description: string;
  year: number;
  tags: string[];
  slug: string;
  cover?: string;
}

const { title, description, year, tags, slug, cover } = Astro.props;
---

<article>
  <a
    href={`/progetti/${slug}`}
    class="group block"
    aria-label={`Vai al progetto: ${title}`}
  >
    <!-- Cover -->
    {cover ? (
      <div
        class="w-full aspect-[16/9] overflow-hidden mb-4 border"
        style="border-color: var(--border);"
      >
        <img
          src={cover}
          alt={`Cover del progetto ${title}`}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : (
      <div
        class="w-full aspect-[16/9] mb-4 border flex items-center justify-center"
        style="border-color: var(--border); background-color: var(--border);"
        aria-hidden="true"
      >
        <span class="font-serif text-4xl opacity-20" style="font-family: 'Fraunces', Georgia, serif;">AT</span>
      </div>
    )}

    <!-- Meta -->
    <div class="flex items-baseline justify-between gap-2 mb-1">
      <h2
        class="font-serif text-xl transition-opacity group-hover:opacity-60"
        style="font-family: 'Fraunces', Georgia, serif; font-weight: 400; color: var(--fg);"
      >
        {title}
      </h2>
      <span class="text-sm tabular-nums shrink-0" style="color: var(--fg-soft);">{year}</span>
    </div>

    <p class="text-sm leading-relaxed mb-3" style="color: var(--fg-soft);">{description}</p>

    <!-- Tags -->
    <ul class="flex flex-wrap gap-2" aria-label="Tags del progetto">
      {tags.map((tag) => (
        <li
          class="text-xs border px-2 py-0.5"
          style="border-color: var(--border); color: var(--fg-soft);"
        >
          {tag}
        </li>
      ))}
    </ul>
  </a>
</article>
