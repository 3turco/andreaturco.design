---
interface Props {
  lang?: 'it' | 'en';
}
const { lang = 'it' } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <div class="container footer-inner">
    <div class="footer-left">© {year} Andrea Turco</div>
    <div class="footer-center">
      <a href="https://www.linkedin.com/in/andreaturco/" target="_blank" rel="noopener">LinkedIn</a>
      <a href="/cv-andrea-turco.pdf" download>CV PDF</a>
    </div>
    <div class="footer-right">
      Designed &amp; built with
      <svg class="footer-heart" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-label="love">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
      &amp; AI in Rome
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 48px 0 32px;
    margin-top: 80px;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
  }

  .footer-left {
    color: var(--text-secondary);
    font-size: 13px;
  }

  .footer-center {
    display: flex;
    gap: 24px;
  }

  .footer-center a {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    transition: color var(--transition);
  }

  .footer-center a:hover {
    color: var(--accent);
  }

  .footer-right {
    text-align: right;
    color: var(--text-secondary);
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
  }

  .footer-heart {
    display: inline-block;
    color: var(--accent);
    vertical-align: -1px;
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .footer-right {
      text-align: left;
      justify-content: flex-start;
    }
  }
</style>
