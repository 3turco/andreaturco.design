---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Journal" description="Coming soon">
  <section class="soon">
    <div class="container">
      <p class="mono label">Journal</p>
      <h1 class="display title">In arrivo.</h1>
      <p class="lead">Sto lavorando ai primi articoli su design system, accessibilità e leadership di team.</p>
      <a href="/" class="link">← Torna alla home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .soon { padding: 120px 0; }
  .label { color: var(--accent); margin-bottom: 8px; }
  .title { font-size: clamp(56px, 10vw, 128px); margin-bottom: 32px; }
  .lead { font-size: 20px; color: var(--text-secondary); max-width: 520px; margin-bottom: 32px; }
  .link { color: var(--text); border-bottom: 1px solid var(--text); padding-bottom: 2px; font-weight: 600; }
  .link:hover { color: var(--accent); border-color: var(--accent); }
</style>
