---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('work', ({ data, id }) => !data.draft && id.startsWith('it/'));
const sorted = projects.sort((a, b) => b.data.year - a.data.year);

function slugOf(id: string) {
  return id.replace(/^(it|en)\//, '');
}
---

<BaseLayout
  title="Progetti"
  description="Progetti di product design: enterprise, pubblica amministrazione, industria. Vent'anni di esperienza."
>
  <section class="work-index">
    <div class="container">
      <header class="wi-header">
        <p class="mono section-label">Selected Projects</p>
        <h1 class="wi-title display">Progetti</h1>
      </header>

      {sorted.length > 0 ? (
        <div class="work-grid">
          {sorted.map((p) => (
            <a href={`/projects/${slugOf(p.id)}`} class="work-card">
              <div class="work-cover">
                {p.data.cover ? (
                  <img src={p.data.cover} alt={p.data.title} />
                ) : (
                  <span class="work-cover-shape">{p.data.client?.substring(0, 2).toUpperCase() ?? '·'}</span>
                )}
              </div>
              <div class="work-meta">
                {p.data.client && <span class="mono work-client">{p.data.client}</span>}
                {p.data.nda && <span class="mono work-nda">NDA</span>}
              </div>
              <h3 class="work-title">{p.data.title.split('·').slice(-1)[0].trim()}</h3>
              <p class="work-desc">{p.data.description}</p>
              <div class="work-tags">
                {p.data.tags.slice(0, 3).map((t: string) => <span class="work-tag">{t}</span>)}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">Nessun progetto ancora pubblicato.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .work-index {
    padding: 80px 0 120px;
  }

  .wi-header {
    margin-bottom: 80px;
  }

  .section-label {
    color: var(--accent);
    margin-bottom: 8px;
  }

  .wi-title {
    font-size: clamp(56px, 10vw, 128px);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px;
  }

  .work-card {
    display: block;
    color: inherit;
    transition: transform var(--transition);
  }

  .work-cover {
    aspect-ratio: 4 / 3;
    background: var(--surface);
    margin-bottom: 20px;
    overflow: hidden;
    position: relative;
  }

  .work-cover img { width: 100%; height: 100%; object-fit: cover; }

  .work-cover-shape {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Oswald', sans-serif; font-weight: 500;
    font-size: 96px; color: var(--text-tertiary); opacity: 0.3;
  }

  .work-meta { display: flex; gap: 16px; align-items: center; margin-bottom: 8px; }
  .work-client { color: var(--text-secondary); }
  .work-nda { color: var(--accent); border: 1px solid var(--accent); padding: 2px 8px; font-size: 9px; }
  .work-title {
    font-family: 'Oswald', sans-serif; font-weight: 500;
    font-size: 36px; line-height: 1; text-transform: uppercase;
    margin-bottom: 12px; color: var(--text);
  }
  .work-desc { color: var(--text-secondary); font-size: 15px; line-height: 1.5; margin-bottom: 16px; }
  .work-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .work-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 4px 10px; border: 1px solid var(--border);
    color: var(--text-secondary);
  }
  .empty { color: var(--text-secondary); }

  @media (max-width: 900px) {
    .work-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
