---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contatti"
  description="Scrivimi per progetti enterprise, consulenza design leadership, advisory."
>
  <section class="contact">
    <div class="container">
      <p class="mono section-label">Get in touch</p>
      <h1 class="ct-title display">
        Restiamo in<br />contatto<span class="ct-dot"></span>
      </h1>

      <div class="ct-grid">
        <div class="ct-block">
          <h2 class="mono ct-label">Email</h2>
          <a href="mailto:hello@andreaturco.design" class="ct-email">hello@andreaturco.design</a>
        </div>

        <div class="ct-block">
          <h2 class="mono ct-label">Location</h2>
          <p>Roma, Italia</p>
        </div>

        <div class="ct-block">
          <h2 class="mono ct-label">LinkedIn</h2>
          <a href="https://www.linkedin.com/in/andreaturco/" target="_blank" rel="noopener">linkedin.com/in/andreaturco ↗</a>
        </div>

        <div class="ct-block">
          <h2 class="mono ct-label">Disponibilità</h2>
          <p>Disponibile per progetti enterprise, consulenza design leadership, advisory.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { padding: 80px 0 120px; }
  .section-label { color: var(--text-secondary); margin-bottom: 32px; }
  .ct-title {
    font-size: clamp(56px, 11vw, 160px);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 80px;
  }
  .ct-dot {
    display: inline-block;
    width: clamp(24px, 4vw, 56px);
    height: clamp(24px, 4vw, 56px);
    background: var(--accent);
    border-radius: 50%;
    margin-left: 12px;
    vertical-align: middle;
  }

  .ct-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px;
    max-width: 800px;
  }

  .ct-block { }
  .ct-label { color: var(--accent); margin-bottom: 16px; }
  .ct-email {
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: clamp(28px, 4vw, 40px);
    color: var(--text);
    border-bottom: 2px solid var(--text);
    padding-bottom: 4px;
    transition: color var(--transition), border-color var(--transition);
    display: inline-block;
  }
  .ct-email:hover { color: var(--accent); border-color: var(--accent); }

  .ct-block p, .ct-block a:not(.ct-email) {
    font-size: 18px;
    color: var(--text);
  }
  .ct-block a:not(.ct-email) {
    border-bottom: 1px solid var(--border);
    padding-bottom: 2px;
    transition: color var(--transition), border-color var(--transition);
  }
  .ct-block a:not(.ct-email):hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 900px) {
    .ct-grid { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
