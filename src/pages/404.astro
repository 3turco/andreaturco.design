---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina non trovata" noindex>
  <section class="not-found">
    <div class="container">
      <h1>Pagina non trovata</h1>
      <p>Questo indirizzo non esiste. <a href="/">Torna alla home</a>.</p>
      <p lang="en">This page does not exist. <a href="/en/">Back to the home page</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { padding: 120px 0; }
  .not-found h1 { margin-bottom: 24px; }
  .not-found a { text-decoration: underline; }
</style>
